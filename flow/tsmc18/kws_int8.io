###############################################################
#  kws_int8.io : IO pin assignment for the INT8 KWS accelerator
#  (loaded by pnr_flow.tcl through init_io_file / loadIoFile)
#  top    : weight memory  w_addr, w_data   (Metal2, vertical)
#  bottom : input memory   x_addr, x_data   (Metal2, vertical)
#  left   : clk, rst_n, start, busy, done, class_out (Metal3)
#  right  : bias memory    b_addr, b_data   (Metal3)
###############################################################
(globals
    version = 3
    io_order = default
)
(iopin
    (top
        (pin name="w_addr[12]" layer=2 width=0.28 depth=0.56)
        (pin name="w_addr[11]" layer=2 width=0.28 depth=0.56)
        (pin name="w_addr[10]" layer=2 width=0.28 depth=0.56)
        (pin name="w_addr[9]" layer=2 width=0.28 depth=0.56)
        (pin name="w_addr[8]" layer=2 width=0.28 depth=0.56)
        (pin name="w_addr[7]" layer=2 width=0.28 depth=0.56)
        (pin name="w_addr[6]" layer=2 width=0.28 depth=0.56)
        (pin name="w_addr[5]" layer=2 width=0.28 depth=0.56)
        (pin name="w_addr[4]" layer=2 width=0.28 depth=0.56)
        (pin name="w_addr[3]" layer=2 width=0.28 depth=0.56)
        (pin name="w_addr[2]" layer=2 width=0.28 depth=0.56)
        (pin name="w_addr[1]" layer=2 width=0.28 depth=0.56)
        (pin name="w_addr[0]" layer=2 width=0.28 depth=0.56)
        (pin name="w_data[7]" layer=2 width=0.28 depth=0.56)
        (pin name="w_data[6]" layer=2 width=0.28 depth=0.56)
        (pin name="w_data[5]" layer=2 width=0.28 depth=0.56)
        (pin name="w_data[4]" layer=2 width=0.28 depth=0.56)
        (pin name="w_data[3]" layer=2 width=0.28 depth=0.56)
        (pin name="w_data[2]" layer=2 width=0.28 depth=0.56)
        (pin name="w_data[1]" layer=2 width=0.28 depth=0.56)
        (pin name="w_data[0]" layer=2 width=0.28 depth=0.56)
    )
    (left
        (pin name="clk" layer=3 width=0.28 depth=0.56)
        (pin name="rst_n" layer=3 width=0.28 depth=0.56)
        (pin name="start" layer=3 width=0.28 depth=0.56)
        (pin name="busy" layer=3 width=0.28 depth=0.56)
        (pin name="done" layer=3 width=0.28 depth=0.56)
        (pin name="class_out[2]" layer=3 width=0.28 depth=0.56)
        (pin name="class_out[1]" layer=3 width=0.28 depth=0.56)
        (pin name="class_out[0]" layer=3 width=0.28 depth=0.56)
    )
    (bottom
        (pin name="x_addr[7]" layer=2 width=0.28 depth=0.56)
        (pin name="x_addr[6]" layer=2 width=0.28 depth=0.56)
        (pin name="x_addr[5]" layer=2 width=0.28 depth=0.56)
        (pin name="x_addr[4]" layer=2 width=0.28 depth=0.56)
        (pin name="x_addr[3]" layer=2 width=0.28 depth=0.56)
        (pin name="x_addr[2]" layer=2 width=0.28 depth=0.56)
        (pin name="x_addr[1]" layer=2 width=0.28 depth=0.56)
        (pin name="x_addr[0]" layer=2 width=0.28 depth=0.56)
        (pin name="x_data[7]" layer=2 width=0.28 depth=0.56)
        (pin name="x_data[6]" layer=2 width=0.28 depth=0.56)
        (pin name="x_data[5]" layer=2 width=0.28 depth=0.56)
        (pin name="x_data[4]" layer=2 width=0.28 depth=0.56)
        (pin name="x_data[3]" layer=2 width=0.28 depth=0.56)
        (pin name="x_data[2]" layer=2 width=0.28 depth=0.56)
        (pin name="x_data[1]" layer=2 width=0.28 depth=0.56)
        (pin name="x_data[0]" layer=2 width=0.28 depth=0.56)
    )
    (right
        (pin name="b_addr[5]" layer=3 width=0.28 depth=0.56)
        (pin name="b_addr[4]" layer=3 width=0.28 depth=0.56)
        (pin name="b_addr[3]" layer=3 width=0.28 depth=0.56)
        (pin name="b_addr[2]" layer=3 width=0.28 depth=0.56)
        (pin name="b_addr[1]" layer=3 width=0.28 depth=0.56)
        (pin name="b_addr[0]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[22]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[21]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[20]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[19]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[18]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[17]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[16]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[15]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[14]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[13]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[12]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[11]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[10]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[9]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[8]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[7]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[6]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[5]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[4]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[3]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[2]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[1]" layer=3 width=0.28 depth=0.56)
        (pin name="b_data[0]" layer=3 width=0.28 depth=0.56)
    )
)
